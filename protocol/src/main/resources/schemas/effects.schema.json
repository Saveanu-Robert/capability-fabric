{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability-fabric.dev/schemas/effects.schema.json",
  "title": "Effects",
  "type": "object",
  "properties": {
    "newTasks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["ref", "title"],
        "properties": {
          "ref": {"type": "string", "minLength": 1, "maxLength": 40},
          "title": {"type": "string", "minLength": 2, "maxLength": 200},
          "description": {"type": ["string", "null"], "maxLength": 2000},
          "dueDate": {"type": ["string", "null"], "format": "date"},
          "dependsOn": {"type": "array", "items": {"type": "string"}, "maxItems": 30},
          "effortHours": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000}
        }
      }
    },
    "taskUpdates": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["task"],
        "properties": {
          "task": {"type": "string", "minLength": 1},
          "effortHours": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000},
          "priority": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000},
          "dueDate": {"type": ["string", "null"], "format": "date"},
          "addDependsOn": {"type": "array", "items": {"type": "string"}, "maxItems": 30},
          "annotations": {"type": "object"}
        }
      }
    },
    "goalAnnotations": {"type": "object"},
    "notes": {"type": ["string", "null"], "maxLength": 4000}
  }
}
