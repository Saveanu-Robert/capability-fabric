{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability-fabric.dev/schemas/manifest.schema.json",
  "title": "CapabilityManifest",
  "type": "object",
  "required": ["id", "version", "provider", "instanceId", "description", "kind", "mode", "heartbeatAt", "ttlSeconds"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-zA-Z0-9-]*)+$", "maxLength": 80},
    "version": {"type": "string", "pattern": "^[0-9]{1,9}\\.[0-9]{1,9}\\.[0-9]{1,9}$"},
    "name": {"type": ["string", "null"], "maxLength": 120},
    "provider": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "instanceId": {"type": "string", "pattern": "^[A-Za-z0-9-]+$", "maxLength": 64},
    "description": {"type": "string", "minLength": 10, "maxLength": 1000},
    "kind": {"enum": ["AI", "DETERMINISTIC"]},
    "mode": {"enum": ["INVOKED", "REACTIVE"]},
    "consumes": {"type": "array", "items": {"type": "string"}, "maxItems": 40},
    "requires": {"type": "array", "items": {"type": "string"}, "maxItems": 40},
    "produces": {"type": "array", "items": {"type": "string"}, "maxItems": 40},
    "annotationSchemas": {"type": "object"},
    "sideEffect": {"enum": ["NONE", "EXTERNAL", "DESTRUCTIVE"]},
    "triggers": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "tags": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "heartbeatAt": {"type": "string"},
    "ttlSeconds": {"type": "integer", "minimum": 3, "maximum": 600}
  }
}
