# Copy to .env and adjust. Every value is optional.

# Where the model server is.
#   Ollama installed on this machine (default, recommended on macOS for GPU):  http://host.docker.internal:11434
#   Bundled container (docker compose --profile ollama up -d):                 http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Chat model used by the AI agents. qwen3.5:4b read everyday sentences best and fastest of the free models tried
# (see Known limitations in README.md); it also runs on CPU.
FABRIC_CHAT_MODEL=qwen3.5:4b

# Embedding model used by the kernel for capability discovery and memory recall.
FABRIC_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Host port for NATS on this machine (127.0.0.1 only). The host CLI uses tls://localhost:4222 unless NATS_URL is set.
NATS_PORT=4222

# live (default) or replay: replay answers every model call from the decision log, without a model.
FABRIC_MODEL_MODE=live

# Human in the loop: capability ids (comma-separated) that need approval, and ids that may never run.
FABRIC_APPROVAL_REQUIRED=
FABRIC_DENIED=

# Changes within a minute from one device that count as unusual: a person's device is asked again, a service calling
# with --decide is refused (NEEDS_OWNER). Raise it for a service that makes changes in batches.
FABRIC_SECURITY_BURST=6

# Your time zone, so "today" and due dates match your calendar (default UTC).
# TZ=Europe/Berlin

# Public holidays (ISO dates, comma-separated), skipped by every calendar-aware capability.
# FABRIC_HOLIDAYS=2026-12-25,2026-12-26

# Extra host names for the gateway's certificate when you run the system on a demo server (comma-separated).
# After changing it run: docker compose up -d   (setup re-issues the certificate and the gateway restarts)
# FABRIC_PUBLIC_HOSTS=fabric.example.org

# Message signing, admission and grants. Turn off only for experiments on a closed machine.
# FABRIC_SECURITY=true

# Port of the HTTPS gateway (the only internet-facing door).
# GATEWAY_PORT=8443

# The address remote devices use to reach the gateway; invitations and pairing instructions show it.
# FABRIC_GATEWAY_URL=https://fabric.example.org:8443

# Optional agents (estimator, sentinel, calendar) belong to the "extras" profile. Once you use them, set this so that
# docker compose up, stop and down include them too (otherwise a rebuild leaves them running their old image).
# COMPOSE_PROFILES=extras
